{
	"name": "nestql",
	"version": "0.0.1",
	"description": "Starter backend with NestJS + GraphQL",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build && tsc-alias -p tsconfig.json",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "node dist/src/app/main.js",
		"start:dev": "nest start --watch",
		"start:dev:docker": "pnpm exec concurrently --kill-others \"pnpm run prisma:generate:watch\" \"pnpm run start:dev\"",
		"start:debug": "node --inspect dist/src/app/main.js",
		"start:prod": "node dist/src/app/main.js",
		"mastra:start:dev": "pnpm run dotenv-cli -e .env -e .env.local -- mastra dev",
		"lint": "eslint src/**/*.ts",
		"type-check": "tsc --noEmit",
		"test:unit": "jest --config test/config/jest.unit.config.js",
		"test:e2e": "jest --config ./test/config/jest.e2e.config.js",
		"test:all": "jest --config ./test/config/jest.unit.config.js && jest --config ./test/config/jest.e2e.config.js",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk node_modules/.bin/jest",
		"---------DOCKER---------": "----------------------------------",
		"docker:show:diskSpace": "docker system df",
		"docker:pruneContainers": "docker rm $(docker ps -a -q) || true",
		"docker:pruneImages": "docker image prune -a -f",
		"docker:pruneVolumes": "docker volume prune -a -f",
		"docker:pruneBuildCache": "docker buildx prune -f",
		"docker:pruneNetworks": "docker network prune -f",
		"docker:pruneSystem": "docker system prune --volumes -af",
		"docker:clean": "pnpm run docker:pruneContainers && pnpm run docker:pruneImages && pnpm run docker:pruneVolumes && pnpm run docker:pruneBuildCache && pnpm run docker:pruneNetworks && pnpm run docker:pruneSystem && pnpm run docker:show:diskSpace",
		"---------NQL-DOCKER---------": "----------------------------------",
		"docker:dev:nql-external-services:up": "docker compose --env-file .env -f src/base/docker/nql-external-services/docker-compose.nql-external-services.dev.yaml up",
		"docker:dev:nql-external-services:down": "docker compose --env-file .env -f src/base/docker/nql-external-services/docker-compose.nql-external-services.dev.yaml down --remove-orphans",
		"docker:dev:nql-external-services:rm:volumes": "docker volume rm nql-external-services_database && docker volume rm nql-external-services_mastra-database && docker volume rm nql-external-services_redis",
		"docker:dev:nql-external-services:clean": "pnpm run docker:dev:nql-external-services:down && pnpm run docker:dev:nql-external-services:rm:volumes",
		"docker:dev:nql-nginx:up": "docker compose --env-file .env -f src/base/docker/nql-nginx/docker-compose.nql-nginx.yaml up",
		"docker:dev:nql-nginx:down": "docker compose --env-file .env -f src/base/docker/nql-nginx/docker-compose.nql-nginx.yaml down --remove-orphans",
		"docker:dev:nql-stack:up": "docker compose --env-file .env -f src/base/docker/nql-external-services/docker-compose.nql-external-services.dev.yaml -f src/base/docker/nql-app/docker-compose.nql-app.base.yaml -f src/base/docker/nql-app/docker-compose.nql-app.dev.yaml -f src/base/docker/nql-nginx/docker-compose.nql-nginx.yaml -f src/base/docker/nql-nginx/docker-compose.nql-nginx.development.yaml up",
		"docker:dev:nql-stack:down": "docker compose --env-file .env -f src/base/docker/nql-external-services/docker-compose.nql-external-services.dev.yaml -f src/base/docker/nql-app/docker-compose.nql-app.base.yaml -f src/base/docker/nql-app/docker-compose.nql-app.dev.yaml -f src/base/docker/nql-nginx/docker-compose.nql-nginx.yaml -f src/base/docker/nql-nginx/docker-compose.nql-nginx.development.yaml down  --remove-orphans",
		"docker:prod:nql-stack:up": "docker compose --env-file .env -f src/base/docker/nql-external-services/docker-compose.nql-external-services.dev.yaml -f src/base/docker/nql-app/docker-compose.nql-app.base.yaml -f src/base/docker/nql-app/docker-compose.nql-app.prod.yaml -f src/base/docker/nql-nginx/docker-compose.nql-nginx.yaml -f src/base/docker/nql-nginx/docker-compose.nql-nginx.development.yaml up",
		"docker:prod:nql-stack:down": "docker compose --env-file .env -f src/base/docker/nql-external-services/docker-compose.nql-external-services.dev.yaml -f src/base/docker/nql-app/docker-compose.nql-app.base.yaml -f src/base/docker/nql-app/docker-compose.nql-app.prod.yaml -f src/base/docker/nql-nginx/docker-compose.nql-nginx.yaml -f src/base/docker/nql-nginx/docker-compose.nql-nginx.development.yaml down  --remove-orphans",
		"---------PRISMA---------": "----------------------------------",
		"prisma:generate": "prisma generate",
		"prisma:generate:watch": "prisma generate --watch",
		"prisma:seed": "node dist/prisma/seed.js",
		"prisma:migrate:reset": "prisma migrate reset --force",
		"prisma:migrate:dev": "prisma migrate dev",
		"prisma:migrate:dev:name": "prisma migrate dev --name",
		"prisma:migrate:dev:reset:full": "rm -rf prisma/migrations && pnpm run prisma:migrate:reset && pnpm run prisma:migrate:dev:name init && pnpm run prisma:seed",
		"----PRISMA-DOCKER----": "----------------------------------",
		"prisma:generate:docker": "docker exec -it nql-app-development sh -c 'pnpm run prisma:generate' && reset",
		"prisma:seed:docker": "docker exec -it nql-app-development sh -c 'pnpm run prisma:seed' && reset",
		"prisma:migrate:reset:docker": "docker exec -it nql-app-development sh -c 'rm -rf prisma/migrations && pnpm run prisma:migrate:reset' && reset",
		"prisma:migrate:dev:docker": "docker exec -it nql-app-development sh -c 'pnpm run prisma:migrate:dev' && reset",
		"prisma:migrate:dev:name:docker": "src/base/sh-scripts/prisma-migrate-name.sh",
		"prisma:migrate:dev:reset:full:docker": "docker exec -it nql-app-development sh -c 'rm -rf prisma/migrations && pnpm run prisma:migrate:reset && pnpm run prisma:migrate:dev:name init && pnpm run prisma:seed' && reset",
		"---------NQL---------": "-----------------------------------",
		"nql:dev:graphql:url": "echo 'https://local.nestql.com/graphql'",
		"nql:gen:password": "node -e \"const crypto = require('crypto'); console.log(crypto.randomBytes(12).toString('base64').replace(/[^a-zA-Z0-9]/g, '').slice(0, 16))\"",
		"nql:gen:strong-password": "node -e \"const crypto = require('crypto'); console.log(crypto.randomBytes(32).toString('hex'))\"",
		"nql:dev:app:generate-certs": "sudo src/base/sh-scripts/generate-certs.sh && sudo src/base/sh-scripts/update-hosts.sh",
		"nql:dev:app:update-hosts": "sudo src/base/sh-scripts/update-hosts.sh",
		"nql:dev:app:setup": "pnpm run nql:dev:app:generate-certs && pnpm run nql:dev:app:update-hosts",
		"nql:dev:app:docker:shell": "docker exec -it nql-app-development sh",
		"nql:generate:model": "pnpm run prisma:generate && tsx src/base/generators/model-generator/start.ts",
		"---------DEPLLOY---------": "-----------------------------------",
		"deploy:prod:full": "infra/scripts/full-deploy.sh"
	},
	"dependencies": {
		"@ai-sdk/amazon-bedrock": "2.2.12",
		"@ai-sdk/openai": "1.3.23",
		"@ai-sdk/provider": "1.1.3",
		"@apollo/server": "4.12.2",
		"@mastra/core": "0.11.1",
		"@mastra/loggers": "0.10.4",
		"@mastra/mcp": "0.10.7",
		"@mastra/memory": "0.11.5",
		"@mastra/pg": "0.12.5",
		"@nestjs/apollo": "13.1.0",
		"@nestjs/bullmq": "11.0.3",
		"@nestjs/common": "11.1.5",
		"@nestjs/config": "4.0.2",
		"@nestjs/core": "11.1.5",
		"@nestjs/graphql": "13.1.0",
		"@nestjs/platform-express": "11.1.5",
		"@prisma/client": "6.12.0",
		"@prisma/generator-helper": "6.15.0",
		"@types/bcrypt": "6.0.0",
		"bcrypt": "6.0.0",
		"bullmq": "5.56.9",
		"class-transformer": "0.5.1",
		"class-validator": "0.14.2",
		"connect-redis": "9.0.0",
		"dotenv": "17.2.1",
		"express-session": "1.18.2",
		"graphql": "16.11.0",
		"graphql-type-json": "0.3.2",
		"mastra": "0.10.15",
		"pluralize": "8.0.0",
		"prisma": "6.12.0",
		"prisma-nestjs-graphql": "21.2.0",
		"redis": "5.6.1",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"uuid": "11.1.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@eslint/compat": "1.3.1",
		"@faker-js/faker": "9.9.0",
		"@jest/globals": "30.1.1",
		"@nestjs/cli": "11.0.7",
		"@nestjs/schematics": "11.0.5",
		"@nestjs/testing": "11.1.5",
		"@prisma/internals": "6.12.0",
		"@types/express": "5.0.3",
		"@types/jest": "30.0.0",
		"@types/jscodeshift": "17.3.0",
		"@types/node": "24.1.0",
		"@types/supertest": "6.0.3",
		"@typescript-eslint/eslint-plugin": "8.38.0",
		"@typescript-eslint/parser": "8.38.0",
		"change-case": "5.4.4",
		"concurrently": "9.2.0",
		"dotenv-cli": "9.0.0",
		"eslint": "9.32.0",
		"eslint-config-flat-gitignore": "2.1.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.3",
		"jest": "30.1.1",
		"jscodeshift": "17.3.0",
		"open": "10.2.0",
		"prettier": "3.6.2",
		"source-map-support": "0.5.21",
		"supertest": "7.1.4",
		"ts-jest": "29.4.1",
		"ts-loader": "9.5.4",
		"tsc-alias": "1.8.10",
		"tsconfig-paths": "4.2.0",
		"tsx": "4.20.5",
		"typescript": "5.8.3"
	},
	"trustedDependencies": [
		"@apollo/protobufjs",
		"@nestjs/core",
		"@prisma/client",
		"@prisma/engines",
		"esbuild",
		"prisma",
		"protobufjs"
	]
}
