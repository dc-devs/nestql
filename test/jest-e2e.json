{
	"moduleFileExtensions": ["js", "json", "ts"],
	"rootDir": ".",
	"testEnvironment": "node",
	"testRegex": ".e2e-spec.ts$",
	"transform": {
		"^.+\\.(t|j)s$": "ts-jest"
	},
	"moduleNameMapping": {
		"^@root/(.*)$": "<rootDir>/../$1",
		"^@src/(.*)$": "<rootDir>/../src/$1",
		"^@base/(.*)$": "<rootDir>/../src/base/$1",
		"^@models/(.*)$": "<rootDir>/../src/app/models/$1",
		"^@routes/(.*)$": "<rootDir>/../src/app/routes/$1"
	}
}
